{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alerting.local/schemas/rule-definition.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "match": {
      "$ref": "#/$defs/condition"
    },
    "severity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "default": "medium"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "body": {
      "type": "string",
      "maxLength": 5000,
      "default": ""
    },
    "dedup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "maxItems": 10,
          "uniqueItems": true,
          "default": []
        },
        "windowSec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 60
        }
      }
    },
    "stopProcessing": {
      "type": "boolean",
      "default": false
    },
    "runbookMode": {
      "enum": [
        "auto",
        "none"
      ],
      "default": "auto"
    }
  },
  "required": [
    "v",
    "match",
    "title"
  ],
  "$defs": {
    "path": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^(payload|meta)(\\.[^.\\[\\]'\\s]+|\\[([0-9]+|\\*)\\]|\\['[^']+'\\])*$"
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/allNode"
        },
        {
          "$ref": "#/$defs/anyNode"
        },
        {
          "$ref": "#/$defs/notNode"
        },
        {
          "$ref": "#/$defs/leaf"
        }
      ]
    },
    "allNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1,
          "maxItems": 50
        }
      },
      "required": [
        "all"
      ]
    },
    "anyNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1,
          "maxItems": 50
        }
      },
      "required": [
        "any"
      ]
    },
    "notNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "not": {
          "$ref": "#/$defs/condition"
        }
      },
      "required": [
        "not"
      ]
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "op": {
          "enum": [
            "exists",
            "eq",
            "ne",
            "in",
            "nin",
            "gt",
            "gte",
            "lt",
            "lte",
            "contains",
            "startsWith",
            "endsWith",
            "regex"
          ]
        },
        "value": true,
        "ignoreCase": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "path",
        "op"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "exists"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "eq",
                  "ne",
                  "contains"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": true
            },
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "in",
                  "nin"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000
              }
            },
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "gt",
                  "gte",
                  "lt",
                  "lte"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "startsWith",
                  "endsWith"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "regex"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "value"
            ]
          }
        }
      ]
    }
  }
}
